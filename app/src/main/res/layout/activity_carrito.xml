<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tu_fondo_difuminado">

    <RelativeLayout
        android:id="@+id/layout_header_carrito"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:padding="10dp"
        android:background="#66000000">

        <ImageButton
            android:id="@+id/btnCarritoAtras"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/ic_circulo"
            android:src="@drawable/ic_flecha_atras"/>
        <TextView
            android:id="@+id/tv_titulo_resumen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/resumen_de_tu_carrito"
            android:textColor="#FFFFFF"
            android:layout_marginLeft="60dp"
            android:textSize="28sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed" />

    </RelativeLayout>

    <!-- Mensaje de carrito vacío -->
    <TextView
        android:id="@+id/tvCarritoVacio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/barraInferior"
        android:gravity="center"
        android:text="Tu carrito está vacío.\nAgrega un plato desde el menú."
        android:textColor="#CCFFFFFF"
        android:textSize="16sp"
        android:visibility="gone" />

    <!-- Card principal del plato -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardPlato"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="100dp"
        app:cardBackgroundColor="#CCFFFFFF"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Fila: nombre + precio -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Nombre y tamaño -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvCarritoNombrePlato"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PIZZA HAWAIANA"
                        android:textColor="#1A1A1A"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCarritoTamano"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PERSONAL"
                        android:textColor="#888888"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

                <!-- Precio item -->
                <TextView
                    android:id="@+id/tvCarritoPrecioItem"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$ 18.000"
                    android:textColor="#1A1A1A"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_gravity="center_vertical" />

            </LinearLayout>

            <!-- Fila: controles de cantidad -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/btnCarritoMenos"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/ic_circulo"
                    android:src="@drawable/ic_menos"
                    android:contentDescription="Menos" />

                <TextView
                    android:id="@+id/tvCarritoCantidad"
                    android:layout_width="36dp"
                    android:layout_height="wrap_content"
                    android:text="1"
                    android:textColor="#1A1A1A"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginHorizontal="8dp" />

                <ImageButton
                    android:id="@+id/btnCarritoMas"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/ic_circulo"
                    android:src="@drawable/ic_mas"
                    android:contentDescription="Más" />

            </LinearLayout>

            <!-- Línea separadora -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#DDDDDD"
                android:layout_marginTop="12dp" />

            <!-- Mensaje "EL TOTAL ES:" en rojo pequeño -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
            android:text="@string/carrito_el_total"
            android:textColor="#A51D21"
            android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="end"
                android:layout_marginTop="6dp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Método de pago -->
    <LinearLayout
        android:id="@+id/layoutMetodoPago"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/cardPlato"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="20dp"
        android:orientation="vertical">


        <!-- Línea separadora -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#AAFFFFFF"
            android:layout_marginTop="12dp" />

    </LinearLayout>

    <!-- Total -->
    <TextView
        android:id="@+id/tvCarritoTotal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/layoutMetodoPago"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:text="TOTAL: $ 18.000"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="end" />

    <!-- Barra de navegación inferior -->
    <include
        android:id="@+id/barraInferior"
        layout="@layout/barra_navegacion"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_alignParentBottom="true" />

    <!-- Botón IR A PAGAR -->
    <Button
        android:id="@+id/btnIrAPagar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_above="@id/barraInferior"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        android:backgroundTint="#8B1A1A"
        android:text="IR A PAGAR $ 18.000"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="28dp" />

</RelativeLayout>





