<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="340dp"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#00000000"
    app:cardCornerRadius="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/fondo_dialogo_transferencia"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Ícono editar -->
        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:layout_marginBottom="8dp"
            android:src="@drawable/ic_editar"
            android:contentDescription="Editar" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="DETALLES DE LA RESERVA"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <!-- Fecha -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnEditFecha"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/borde_spinner_oscuro"
            android:textColor="#FFFFFF"
            android:text="Fecha"
            android:gravity="center_vertical|start"
            android:paddingHorizontal="15dp"
            android:textAllCaps="false"
            android:textSize="14sp" />

        <!-- Bloque horario -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnEditHora"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/borde_spinner_oscuro"
            android:textColor="#FFFFFF"
            android:text="Hora"
            android:gravity="center_vertical|start"
            android:paddingHorizontal="15dp"
            android:textAllCaps="false"
            android:textSize="14sp" />

        <!-- Temática -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnEditTematica"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/borde_spinner_oscuro"
            android:textColor="#FFFFFF"
            android:text="Temática"
            android:gravity="center_vertical|start"
            android:paddingHorizontal="15dp"
            android:textAllCaps="false"
            android:textSize="14sp" />

        <!-- Personas + Piso en fila -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp"
            android:weightSum="2">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEditPersonas"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:background="@drawable/borde_spinner_oscuro"
                android:hint="Personas"
                android:textColor="#FFFFFF"
                android:textColorHint="#99FFFFFF"
                android:inputType="number"
                android:maxLength="2"
                android:paddingHorizontal="15dp"
                android:textSize="14sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnEditPiso"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:background="@drawable/borde_spinner_oscuro"
                android:textColor="#FFFFFF"
                android:text="Piso"
                android:gravity="center_vertical|start"
                android:paddingHorizontal="15dp"
                android:textAllCaps="false"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Botón Actualizar -->
        <Button
            android:id="@+id/btnActualizarReserva"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#A51D21"
            android:text="ACTUALIZAR RESERVA"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:cornerRadius="25dp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>

