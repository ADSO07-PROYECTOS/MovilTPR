<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tu_fondo_difuminado">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarSuperior"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#66000000">

        <ImageButton
            android:id="@+id/btnAtras"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/ic_circulo"
            android:src="@drawable/ic_flecha_atras"
            android:padding="8dp"
            android:layout_gravity="start"
            android:contentDescription="@string/previous" />


    </androidx.appcompat.widget.Toolbar>

    <TextView
        android:id="@+id/titleMenu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/toolbarSuperior"
        android:layout_marginTop="10dp"
        android:text="@string/menu_title"
        android:textColor="#FFFFFF"
        android:textSize="35sp"
        android:textStyle="bold" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/containerPrincipal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/titleMenu"
        android:layout_above="@+id/barraInferior"
        app:cardBackgroundColor="#66000000"
        app:cardCornerRadius="25dp"
        >

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <!-- Nombre del plato (cargado dinámicamente) -->
                <TextView
                    android:id="@+id/tvNombrePlato"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pizza_name"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <!-- Imagen del plato (cargada con Glide) -->
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imgPlato"
                    android:layout_width="200dp"
                    android:layout_height="120dp"
                    android:layout_marginTop="10dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/plato1"
                    app:shapeAppearanceOverlay="@style/RoundedCornersImage" />

                <!-- Descripción del plato -->
                <TextView
                    android:id="@+id/tvDescripcionPlato"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="@string/pizza_description"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <!-- Tamaños: botón que abre ventana emergente -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/size_button"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSeleccionarTamano"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="220dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/seleccionar_tamano"
                    android:textColor="#FFFFFF"
                    app:strokeColor="#FFFFFF"
                    app:iconGravity="end"
                    app:icon="@drawable/ic_dropdown"
                    app:iconTint="#FFFFFF" />

                <!-- Adiciones -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/ask_additions"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:layout_gravity="center_horizontal" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/additions_note"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:layout_gravity="center_horizontal" />

                <LinearLayout
                    android:id="@+id/layoutAdiciones"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/borde_rojo_blanco"
                    android:orientation="vertical" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="15dp"
                    android:layout_marginBottom="15dp"
                    android:background="#FFFFFF" />

                <!-- Sabores -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ask_sabores"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:layout_gravity="center_horizontal" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/sabores_note"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:layout_gravity="center_horizontal" />

                <LinearLayout
                    android:id="@+id/layoutSabores"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/borde_rojo_blanco"
                    android:orientation="vertical" />

            </LinearLayout>
        </ScrollView>
    </com.google.android.material.card.MaterialCardView>

    <!-- Barra inferior: cantidad + precio dinámico -->
    <LinearLayout
        android:id="@+id/barraInferior"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_above="@+id/barraNavegacion"
        android:background="#E0E0E0"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageButton
            android:id="@+id/btnMenos"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/ic_circulo"
            android:src="@drawable/ic_menos"
            android:contentDescription="@string/previous" />

        <TextView
            android:id="@+id/tvCantidad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="15dp"
            android:text="@string/quantity_default"
            android:textColor="#A51D21"
            android:textSize="24sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnMas"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/ic_circulo"
            android:src="@drawable/ic_mas"
            android:contentDescription="@string/next" />

        <Button
            android:id="@+id/btnAnadir"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:backgroundTint="#A51D21"
            android:text="@string/add_button"
            app:cornerRadius="25dp" />

        <TextView
            android:id="@+id/tvPrecioTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/price_placeholder"
            android:textColor="#A51D21"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Barra de navegación inferior -->
    <include
        android:id="@+id/barraNavegacion"
        layout="@layout/barra_navegacion"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true" />

</RelativeLayout>