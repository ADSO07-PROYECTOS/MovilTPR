<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tu_fondo_difuminado"
    android:orientation="vertical"
    android:gravity="center">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        app:cardBackgroundColor="#CC1A1A1A"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fadeScrollbars="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Logo Sabores Unidos -->
                <ImageView
                    android:layout_width="120dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/saboresunidos"
                    android:contentDescription="Sabores Unidos" />

                <!-- Título -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ENVÍO"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginBottom="24dp" />

                <!-- Dirección completa -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Dirección completa"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    app:boxStrokeColor="@color/text_input_stroke_color"
                    app:hintTextColor="@color/rojo_primario"
                    app:boxBackgroundColor="#33FFFFFF"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDireccion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Calle 10 # 12-34"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#99FFFFFF"
                        android:inputType="textPostalAddress"
                        android:maxLength="80" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Barrio / Referencia -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Barrio / Referencia"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    app:boxStrokeColor="@color/text_input_stroke_color"
                    app:hintTextColor="@color/rojo_primario"
                    app:boxBackgroundColor="#33FFFFFF"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etBarrio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Edificio Torres del Parque, Apto 502"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#99FFFFFF"
                        android:inputType="text"
                        android:maxLength="60" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Método de pago -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Método de pago"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnMetodoPago"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/borde_spinner_oscuro"
                    android:textColor="#FFFFFF"
                    android:text="Efectivo (Contra entrega)"
                    android:gravity="center_vertical|start"
                    android:paddingHorizontal="15dp"
                    android:textAllCaps="false" />

                <!-- Botones -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <Button
                        android:id="@+id/btnVolverDomicilio"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:backgroundTint="#FFFFFF"
                        android:text="VOLVER"
                        android:textColor="#A51D21"
                        android:textStyle="bold"
                        app:cornerRadius="25dp" />

                  <Button
                    android:id="@+id/btnConfirmarPedido"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:padding="5dp"
                    android:backgroundTint="#A51D21"
                    android:text="CONFIRMAR PEDIDO"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    app:cornerRadius="25dp" />

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

    </androidx.cardview.widget.CardView>
</LinearLayout>

