<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#E01A1A1A"
    android:padding="24dp">

    <!-- Título -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="¿CÓMO QUIERES TU PEDIDO?"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <!-- Subtítulo -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ELIGE UNA OPCIÓN PARA CONTINUAR"
        android:textColor="#AAAAAA"
        android:textSize="11sp"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <!-- Botón Reservar -->
    <Button
        android:id="@+id/btnReservarRestaurante"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:backgroundTint="#A51D21"
        android:text="RESERVAR EN EL RESTAURANTE"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp"
        app:cornerRadius="8dp" />

    <!-- Botón Domicilio -->
    <Button
        android:id="@+id/btnDomicilio"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        app:strokeColor="#A51D21"
        app:strokeWidth="1.5dp"
        android:backgroundTint="#00000000"
        android:text="DOMICILIO"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"
        app:cornerRadius="8dp" />

    <!-- Cancelar -->
    <TextView
        android:id="@+id/btnCancelar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CANCELAR"
        android:textColor="#AAAAAA"
        android:textSize="13sp"
        android:gravity="center"
        android:padding="8dp" />

</LinearLayout>

