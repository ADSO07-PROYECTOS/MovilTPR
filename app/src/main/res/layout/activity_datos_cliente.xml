<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/tu_fondo_difuminado"
  android:orientation="vertical"
  android:gravity="center">

  <androidx.cardview.widget.CardView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="24dp"
    app:cardBackgroundColor="#CC1A1A1A"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp">

    <ScrollView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:fadeScrollbars="false">

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Logo Sabores Unidos -->
        <ImageView
          android:layout_width="120dp"
          android:layout_height="44dp"
          android:layout_gravity="center"
          android:layout_marginBottom="12dp"
          android:scaleType="fitCenter"
          android:src="@drawable/saboresunidos"
          android:contentDescription="Sabores Unidos" />

        <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="TUS DATOS"
          android:textColor="#FFFFFF"
          android:textSize="24sp"
          android:textStyle="bold"
          android:gravity="center"
          android:layout_marginBottom="24dp" />

        <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="Nombre"
          android:textColor="#FFFFFF"
          android:textSize="13sp"
          android:layout_marginBottom="4dp" />

        <com.google.android.material.textfield.TextInputLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="16dp"
          style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
          app:boxStrokeColor="@color/text_input_stroke_color"
          app:hintTextColor="@color/rojo_primario"
          app:boxBackgroundColor="#33FFFFFF"
          app:hintEnabled="false">

          <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Juan Posada"
            android:textColor="#FFFFFF"
            android:textColorHint="#99FFFFFF"
            android:inputType="textPersonName"
            android:maxLength="30" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="Cedula"
          android:textColor="#FFFFFF"
          android:textSize="13sp"
          android:layout_marginBottom="4dp" />

        <com.google.android.material.textfield.TextInputLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="16dp"
          style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
          app:boxStrokeColor="@color/text_input_stroke_color"
          app:hintTextColor="@color/rojo_primario"
          app:boxBackgroundColor="#33FFFFFF"
          app:hintEnabled="false">

          <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etCedula"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="1112000000"
            android:textColor="#FFFFFF"
            android:textColorHint="#99FFFFFF"
            android:inputType="number"
            android:maxLength="10" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="Correo"
          android:textColor="#FFFFFF"
          android:textSize="13sp"
          android:layout_marginBottom="4dp" />

        <com.google.android.material.textfield.TextInputLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="16dp"
          style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
          app:boxStrokeColor="@color/text_input_stroke_color"
          app:hintTextColor="@color/rojo_primario"
          app:boxBackgroundColor="#33FFFFFF"
          app:hintEnabled="false">

          <com.google.android.material.textfield.TextInputEditText
              android:id="@+id/etCorreo"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:hint="ejemplo@gmail.com"
              android:inputType="textEmailAddress"
              android:maxLength="60"
              android:textColor="#FFFFFF"
              android:textColorHint="#99FFFFFF" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="Telefono"
          android:textColor="#FFFFFF"
          android:textSize="13sp"
          android:layout_marginBottom="4dp" />

        <com.google.android.material.textfield.TextInputLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="24dp"
          style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
          app:boxStrokeColor="@color/text_input_stroke_color"
          app:hintTextColor="@color/rojo_primario"
          app:boxBackgroundColor="#33FFFFFF"
          app:hintEnabled="false">

          <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etTelefono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="3154444444"
            android:textColor="#FFFFFF"
            android:textColorHint="#99FFFFFF"
            android:inputType="phone"
            android:maxLength="10" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Checkbox Habeas Data -->
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:layout_marginBottom="20dp"
          android:gravity="center_vertical">

          <CheckBox
            android:id="@+id/cbHabeasData"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="#A51D21"
            android:layout_marginEnd="8dp" />

          <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Autorizo la recopilación y tratamiento de mis datos personales conforme a la política de Habeas Data de Sabores Unidos. Mi información será usada únicamente para gestionar el pedido."
            android:textColor="#CCFFFFFF"
            android:textSize="11sp"
            android:lineSpacingExtra="2dp" />

        </LinearLayout>

        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:weightSum="2">

          <Button
            android:id="@+id/btnVolver"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:backgroundTint="#FFFFFF"
            android:text="VOLVER"
            android:textColor="#A51D21"
            android:textStyle="bold"
            app:cornerRadius="25dp" />

          <Button
            android:id="@+id/btnContinuar"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:backgroundTint="#A51D21"
            android:text="CONTINUAR"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:cornerRadius="25dp" />

        </LinearLayout>

      </LinearLayout>

    </ScrollView>

  </androidx.cardview.widget.CardView>
</LinearLayout>
