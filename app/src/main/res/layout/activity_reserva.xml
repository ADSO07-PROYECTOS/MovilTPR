<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tu_fondo_difuminado"
    android:orientation="vertical"
    android:gravity="center">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        app:cardBackgroundColor="#CC1A1A1A"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp">
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">
                <!-- Logo Sabores Unidos -->
                <ImageView
                    android:layout_width="120dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/saboresunidos"
                    android:contentDescription="Sabores Unidos" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="RESERVA"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginBottom="20dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Fecha"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:layout_marginBottom="4dp" />
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnFecha"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/borde_spinner_oscuro"
                    android:textColor="#FFFFFF"
                    android:text="Seleccionar Fecha"
                    android:gravity="center_vertical|start"
                    android:paddingHorizontal="15dp"
                    android:textAllCaps="false"
                    android:drawableStart="@drawable/ic_calendario"
                    android:drawablePadding="10dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Bloque Horario"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:layout_marginBottom="4dp" />
              <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnBloque"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/borde_spinner_oscuro"
                android:textColor="#FFFFFF"
                android:text="Seleccionar Bloque"
                android:gravity="center_vertical|start"
                android:paddingHorizontal="15dp"
                android:textAllCaps="false"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Temática"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:layout_marginBottom="4dp" />
              <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnTematica"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/borde_spinner_oscuro"
                android:textColor="#FFFFFF"
                android:text="Cargando temáticas..."
                android:gravity="center_vertical|start"
                android:paddingHorizontal="15dp"
                android:textAllCaps="false"
                android:enabled="false"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Personas"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:layout_marginBottom="4dp" />
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    app:boxStrokeColor="@color/text_input_stroke_color"
                    app:hintTextColor="@color/rojo_primario"
                    app:boxBackgroundColor="#33FFFFFF">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPersonas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/borde_spinner_oscuro"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#FFFFFF"
                        android:inputType="number"
                        android:maxLength="2" />
                </com.google.android.material.textfield.TextInputLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Piso"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:layout_marginBottom="4dp" />
                <androidx.appcompat.widget.AppCompatButton
                  android:id="@+id/btnPiso"
                  android:layout_width="match_parent"
                  android:layout_height="50dp"
                  android:layout_marginBottom="16dp"
                  android:background="@drawable/borde_spinner_oscuro"
                  android:textColor="#FFFFFF"
                  android:text="Seleccionar Piso"
                  android:gravity="center_vertical|start"
                  android:paddingHorizontal="15dp"
                  android:textAllCaps="false"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Método de pago"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:layout_marginBottom="4dp" />
                <androidx.appcompat.widget.AppCompatButton
                  android:id="@+id/btnMetodoPago"
                  android:layout_width="match_parent"
                  android:layout_height="50dp"
                  android:layout_marginBottom="24dp"
                  android:background="@drawable/borde_spinner_oscuro"
                  android:textColor="#FFFFFF"
                  android:text="Seleccionar Método"
                  android:gravity="center_vertical|start"
                  android:paddingHorizontal="15dp"
                  android:textAllCaps="false"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2">
                    <Button
                        android:id="@+id/btnVolverReserva"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:backgroundTint="#FFFFFF"
                        android:text="VOLVER"
                        android:textColor="#A51D21"
                        android:textStyle="bold"
                        app:cornerRadius="25dp" />
                    <Button
                        android:id="@+id/btnReservar"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:backgroundTint="#A51D21"
                        android:text="RESERVAR"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        app:cornerRadius="25dp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </androidx.cardview.widget.CardView>
</LinearLayout>