<resources>
  <!-- Base application theme. -->
  <style name="Base.Theme.AppReserva" parent="Theme.Material3.DayNight.NoActionBar">
    <item name="colorPrimary">@color/rojo_primario</item>
    <item name="colorPrimaryVariant">@color/rojo_oscuro</item>
    <item name="colorOnPrimary">@color/blanco</item>
    <item name="colorSecondary">@color/rojo_oscuro</item>
    <item name="colorSecondaryVariant">@color/rojo_oscuro</item>
    <item name="colorOnSecondary">@color/blanco</item>
    <item name="colorAccent">@color/rojo_primario</item>

    <item name="android:colorControlActivated">@color/rojo_primario</item>
    <item name="android:colorControlHighlight">#33A51D21</item>
    <item name="android:textColorHighlight">#55A51D21</item>

    <item name="colorControlActivated">@color/rojo_primario</item>
    <item name="colorControlNormal">@color/gris_claro</item>

    <item name="colorSurface">@color/blanco</item>
    <item name="colorOnSurface">@color/black</item>
    <item name="colorPrimaryContainer">@color/rojo_primario</item>
    <item name="colorOnPrimaryContainer">@color/blanco</item>
    <item name="colorSecondaryContainer">@color/rojo_oscuro</item>
    <item name="colorOnSecondaryContainer">@color/blanco</item>
    <item name="colorTertiary">@color/rojo_primario</item>
    <item name="colorOnTertiary">@color/blanco</item>

    <item name="colorSurfaceVariant">@color/gris_claro</item>
  </style>

  <style name="Theme.AppReserva" parent="Base.Theme.AppReserva" />

  <style name="DialogTamano" parent="Theme.MaterialComponents.Dialog.Alert">
    <item name="android:background">#CC1A1A1A</item>
    <item name="android:textColor">#FFFFFF</item>
    <item name="colorAccent">#A51D21</item>
    <item name="colorPrimary">#A51D21</item>
    <item name="colorSecondary">#A51D21</item>
    <item name="colorControlActivated">#A51D21</item>
    <item name="android:colorControlActivated">#A51D21</item>
    <item name="android:windowMinWidthMajor">80%</item>
    <item name="android:windowMinWidthMinor">80%</item>
  </style>
  <style name="CalendarioPersonalizado" parent="Theme.MaterialComponents.Light.Dialog.Alert">
    <item name="colorAccent">#555555</item>
    <item name="android:windowBackground">@android:color/transparent</item>
    <item name="android:background">#333333</item>
    <item name="android:textColorPrimary">#FFFFFF</item>
    <item name="android:textColorSecondary">#555555</item>
  </style>
</resources>
