<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.sena.myapplication">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/saboresunidos"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/saboresunidos"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppReserva"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".views.MisReservasActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".views.ConfirmacionReservaActivity"
            android:exported="false" />
        <activity
            android:name=".views.DomicilioActivity"
            android:exported="false" />
        <activity
            android:name=".views.DatosClienteActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />
        <activity
            android:name=".views.ReservaActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />
        <activity
            android:name=".views.CarritoActivity"
            android:exported="false" />
        <activity
            android:name=".views.PlatoDetalleActivity"
            android:exported="false"
            android:theme="@style/Theme.AppReserva" />
        <activity
            android:name=".views.VerPlatosActivity"
            android:exported="false" />
        <activity
            android:name=".views.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
